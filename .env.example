# ==================================================
# 🚀 TruyenKomi Environment Template (.env.example)
# ==================================================

# 1. Database & Cache
DB_CONNECTION_STRING="Host=localhost;Port=5432;Database=TruyenKomiDb;Username=postgres;Password=your_db_password_here;"
REDIS_CONNECTION_STRING="localhost:6379,abortConnect=false"

# 2. JWT Authentication
JWT_SECRET="your_super_secret_jwt_key_at_least_32_chars_long!"
JWT_ISSUER="TruyenKomiAPI"
JWT_AUDIENCE="TruyenKomiClient"
JWT_EXPIRY_DAYS=7

# 3. Google OAuth 2.0 (Social Login)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 4. Primary Cloud Storage (Google Cloud Storage - S3 Interoperability)
R2_ENDPOINT="storage.googleapis.com"
R2_ACCESS_KEY="your_gcs_access_key"
R2_SECRET_KEY="your_gcs_secret_key"
R2_BUCKET_NAME="truyenkomi"
R2_SECURE=true
# CDN bọc trước GCS (Sử dụng domain Cloudflare để cache ảnh 0đ Egress)
R2_CDN_BASE_URL="https://img.truyenkomi.site"

# 5. Cloudflare R2 - Database Backup Storage (S3 API Key)
CF_R2_ENDPOINT="your_account_id.r2.cloudflarestorage.com"
CF_R2_ACCESS_KEY="your_cf_r2_access_key"
CF_R2_SECRET_KEY="your_cf_r2_secret_key"
CF_R2_BUCKET="truyenkomi"

# 6. Backblaze B2 Account Info (Optional Backup)
B2_ACCOUNT_EMAIL="your_email@example.com"
B2_ACCOUNT_PASSWORD="your_password"

# 7. Meilisearch Fulltext Search Engine
MEILISEARCH_HOST="http://localhost:7700"
MEILI_MASTER_KEY="your_meilisearch_master_key"

# 8. Web App & Tunnel Routing
APP_ENV="Development"
API_PORT=5000
FRONTEND_PORT=4200
PUBLIC_DOMAIN="https://truyenkomi.com"
API_BASE_URL="https://truyenkomi.com/api"